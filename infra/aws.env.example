# MeCoil AWS deployment config.
#
# Copy this file to `infra/aws.env` and fill in the values. `infra/aws.env` is
# gitignored and must NEVER be committed.
#
# AWS CREDENTIALS ARE NOT STORED HERE. Export them in your terminal from the AWS
# console before running any `make aws-*` target, e.g.:
#     export AWS_ACCESS_KEY_ID=...
#     export AWS_SECRET_ACCESS_KEY=...
#     export AWS_SESSION_TOKEN=...        # if using temporary credentials
# The CDK/CLI pick these up automatically from the environment.

# ── Required ────────────────────────────────────────────────────────────────

# AWS region to deploy into.
AWS_REGION=eu-west-1

# The ONLY source IP allowed to reach SSH (port 22), as a bare IPv4 address.
# This is almost always your current public IP. Find it with:  curl -s https://checkip.amazonaws.com
# A /32 is appended automatically.
SSH_ALLOWED_IP=203.0.113.10

# ── Optional ────────────────────────────────────────────────────────────────

# EC2 instance type (Graviton/arm64). Default t4g.micro is the cost-optimized pick.
INSTANCE_TYPE=t4g.micro

# Friendly DNS name + its parent Route53 hosted zone. Leave BOTH blank to deploy
# with just the Elastic IP and a Caddy self-signed (internal CA) certificate.
#
# When set, CDK creates an A-record (DOMAIN_NAME -> Elastic IP) in the existing
# hosted zone, and Caddy obtains a real Let's Encrypt certificate automatically.
# You must already own the domain and have its hosted zone in this AWS account.
#   DOMAIN_NAME=mecoil.example.com
#   HOSTED_ZONE=example.com
DOMAIN_NAME=
HOSTED_ZONE=
