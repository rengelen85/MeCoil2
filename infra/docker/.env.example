# Copy to .env at the repo root (next to docker-compose.yml) and edit.
#   cp infra/docker/.env.example .env

# Domain Caddy should serve + request a TLS certificate for.
# Use a real DNS name pointed at this host for a Let's Encrypt cert.
# Leave as localhost to smoke-test with Caddy's internal CA.
MECOIL_DOMAIN=localhost

# Email for Let's Encrypt/ACME notices. Required for a public-domain cert;
# leave blank for the localhost/internal-CA case.
MECOIL_TLS_EMAIL=
